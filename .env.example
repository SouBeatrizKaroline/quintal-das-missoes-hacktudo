# Somente a oficina do educador lê a chave. Nunca coloque em public/.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Senha exclusiva do educador, mínimo de 20 caracteres. Não é a chave Gemini.
TEACHER_TOKEN=
PORT=3000
TEACHER_PORT=3001
# Padrão local. Para expor o jogo na rede, configure somente GAME_HOST.
GAME_HOST=127.0.0.1
